---
import SiteHead from '@/components/SiteHead.astro'
import press from '@/content/press.json'
import '@/styles/dee.css'
import '@/styles/press.css'
const sections = [['stories','Story angles'],['watch','Apple Watch'],['features','Feature reference'],['android','Android'],['downloads','Downloads'],['review','For reviewers'],['creator','The creator']]
const core = press.assets.filter(a => a.group === 'core')
const localized = press.assets.filter(a => a.group === 'localized')
---
<!doctype html>
<html lang="en-GB">
<head><SiteHead exactTitle="Dee press kit — Muay Thai, in your corner" description={press.shortDescription} image={{src:'/press/assets/overview-poster.jpg',alt:'Dee Muay Thai Coach press kit'}} /><link rel="preload" href="/fonts/barlow-condensed-black.woff2" as="font" type="font/woff2" crossorigin /></head>
<body class="press-page">
<a class="skip-link" href="#main">Skip to content</a>
<header class="press-header"><a class="press-brand" href="/" aria-label="Dee home"><img src="/press/assets/dee-app-icon.png" width="42" height="42" alt=""/><span>DEE</span></a><span class="eyebrow">The press room</span><a href={`mailto:${press.contact}`}>Get in touch <span aria-hidden="true">↗</span></a></header>
<main id="main">
<section class="press-hero wrap">
 <div class="hero-copy"><p class="eyebrow">Independent app. In your corner.</p><h1>Your plan.<br/>Your round.<br/><em>Your corner.</em></h1><p class="intro">{press.shortDescription}</p><div class="action-row"><a class="press-button" href="/press/dee-press-kit.zip" download>Download the press kit <span aria-hidden="true">↓</span></a><a class="text-link" href="/press/dee-fact-sheet.pdf">Two-page fact sheet ↗</a></div><p class="micro">By {press.creator} · <a href={`mailto:${press.contact}`}>{press.contact}</a><br/>Updated {press.updated}</p></div>
 <div class="hero-art"><span class="art-label">BUILT FOR THE ROUND</span><img class="hero-phone" src="/press/screenshots/iphone-round-en.png" alt="Dee’s round timer, with drill instructions and the next rest period" width="1320" height="2868" fetchpriority="high"/><div class="hero-watch"><img src="/press/screenshots/watch-active.png" alt="An independent Dee workout on Apple Watch" width="368" height="448"/><span>SYNC. THEN GO.</span></div><span class="art-foot">iPhone + Apple Watch · simulator captures</span></div>
</section>
<div class="press-index"><nav class="wrap" aria-label="Press kit contents">{sections.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav></div>
<section class="wrap section" id="stories"><div class="section-heading"><p class="eyebrow">01 / The story</p><h2>Three ways into Dee.</h2></div><div class="story-grid">{press.storyAngles.map((story,i)=><article><span class="story-number">0{i+1}</span><h3>{story.title}</h3><p>{story.body}</p></article>)}</div></section>
<section class="watch-section" id="watch"><div class="wrap watch-grid"><div><p class="eyebrow">02 / Already on your wrist</p><h2>Sync once.<br/>Train without<br/><em>your phone.</em></h2><p class="intro">{press.watch.body}</p><ol class="watch-steps">{press.watch.steps.map(step=><li>{step}</li>)}</ol><p class="micro">{press.watch.note}</p></div><div class="watch-pair"><figure><img src="/press/screenshots/watch-library.png" alt="Dee’s stored workout library on Watch" width="368" height="448" loading="lazy"/><figcaption>01 / Choose your session</figcaption></figure><figure><img src="/press/screenshots/watch-active.png" alt="A workout running independently on Apple Watch" width="368" height="448" loading="lazy"/><figcaption>02 / Stay in the round</figcaption></figure></div></div></section>
<section class="wrap section" id="features"><div class="section-heading"><p class="eyebrow">03 / The feature reference</p><h2>From the first plan<br/>to the final bell.</h2><p>Apple features are described here. <a href="#android">See Android’s capabilities below.</a></p></div><div class="feature-list">{press.features.map((feature,i)=><details id={feature.id} open={i===0}><summary><span class="feature-index">{String(i+1).padStart(2,'0')}</span><span>{feature.title}<small>{feature.platform}</small></span><span class="expand" aria-hidden="true">+</span></summary><div class="feature-body"><p>{feature.body}</p><ul>{feature.details.map(detail=><li>{detail}</li>)}</ul>{feature.id==='ai-privacy'&&<a href="/privacy/">Read the privacy policy ↗</a>}</div></details>)}</div></section>
<section class="android-section" id="android"><div class="wrap android-grid"><div><p class="eyebrow">04 / Also on Android</p><h2>Your corner.<br/>On your phone.</h2><p class="intro">{press.android.body}</p><ul>{press.android.features.map(feature=><li>{feature}</li>)}</ul><p>{press.android.requirements}</p><p>{press.android.access}</p><p class="micro">{press.android.differences}</p><a class="press-button" href={press.googlePlay}>Get Dee on Google Play ↗</a></div><figure><img src="/press/screenshots/android-round.png" alt="Dee’s Android workout screen with work timer and drill instructions" width="1080" height="2340" loading="lazy"/><figcaption>Android · app-rendered sample workout</figcaption></figure></div></section>
<section class="wrap section" id="downloads"><div class="section-heading"><p class="eyebrow">05 / Ready for your story</p><h2>The assets. All here.</h2><p>{press.captureNote}</p></div><div class="download-grid"><a class="download-item" href="/press/dee-press-kit.zip" download><span>01 / Everything in one place</span><strong>Press kit ZIP</strong><small>Original screenshots, brand assets, copy, fact sheet & videos ↓</small></a><a class="download-item" href="/press/dee-fact-sheet.pdf"><span>02 / The essential facts</span><strong>Two-page PDF</strong><small>Product, platforms, release, access & contact ↗</small></a><a class="download-item" href="/press/dee-editorial-copy.txt" download><span>03 / Copy and credits</span><strong>Editorial text</strong><small>Descriptions, feature reference, captions & credits ↓</small></a></div>
<h3 class="subhead">See Dee in motion.</h3><div class="video-grid">{press.videos.map(v=><figure><video controls playsinline preload="none" poster={v.poster} aria-label={v.title}><source src={v.file} type="video/mp4"/><track default kind="captions" src={v.captions} srclang="en" label="English"/><p><a href={v.file}>Download {v.title}</a></p></video><figcaption><strong>{v.title} <span>{v.duration}</span></strong><p>{v.caption}</p><a href={v.file} download>MP4 ↓</a> · <a href={v.captions} download>Captions ↓</a></figcaption></figure>)}</div>
<h3 class="subhead">Original screenshots.</h3><div class="asset-filters" role="group" aria-label="Filter screenshots">{['All','iPhone','iPad','Apple Watch','Android'].map((p,i)=><button type="button" data-filter={p} aria-pressed={i===0}>{p}</button>)}</div><p class="sr-only" id="filter-status" aria-live="polite"></p><div class="asset-grid">{core.map(a=><figure data-platform={a.platform}><a href={a.file} download aria-label={`Download ${a.title}`} class="asset-image"><img src={a.file} alt={a.caption} width={a.width} height={a.height} loading="lazy"/></a><figcaption><span>{a.platform}</span><strong>{a.title}</strong><p>{a.caption}</p><a href={a.file} download>Original PNG · {a.width} × {a.height} ↓</a></figcaption></figure>)}</div>
<h3 class="subhead">One round. Seven languages.</h3><p>The English original is above. These are the same workout in Dee’s other six languages.</p><div class="locale-grid">{localized.map(a=><figure><a href={a.file} download><img src={a.file} alt={a.caption} width={a.width} height={a.height} loading="lazy"/></a><figcaption><strong>{a.title}</strong><a href={a.file} download>Original PNG ↓</a></figcaption></figure>)}</div>
<div class="brand-downloads"><div><h3>Brand & creator</h3><p>Owned assets, ready for editorial use.</p></div><a href="/press/assets/dee-app-icon.png" download>Apple app icon ↓</a><a href="/press/assets/dee-android-icon.png" download>Android icon ↓</a><a href="/press/assets/dee-wordmark.svg" download>Wordmark SVG ↓</a><a href={press.founder.image} download>Creator image ↓</a><a href="/press/assets/dee-presentation.png" download>Presentation image ↓</a></div><p class="credits">{press.credits}</p>
</section>
<section class="review-section" id="review"><div class="wrap"><div class="section-heading"><p class="eyebrow">06 / Take it for a round</p><h2>For reviewers.</h2></div><div class="review-grid"><div><div class="release-box"><p class="eyebrow">Current release · {press.updated}</p><h3>iOS {press.release.ios}<br/>Android {press.release.android}</h3><p>{press.release.news}</p><p>{press.release.requirements}</p><p>{press.release.access}</p><p class="micro">{press.release.pricingNote}</p><div class="action-row"><a href={press.appStore}>App Store ↗</a><a href={press.googlePlay}>Google Play ↗</a></div></div><p>{press.reviewerAccess}</p><a class="text-link" href={`mailto:${press.contact}?subject=Dee%20review%20access`}>Request review access ↗</a></div><ol class="walkthrough">{press.reviewer.map(s=><li><h3>{s.title}</h3><p>{s.body}</p></li>)}</ol></div></div></section>
<section class="wrap section" id="creator"><div class="creator-grid"><figure><img src={press.founder.image} alt="Noam Efergan, creator of Dee" width="1280" height="720" loading="lazy"/><figcaption>{press.founder.caption}</figcaption></figure><div><p class="eyebrow">07 / Meet the creator</p><h2>{press.founder.title}</h2><p class="intro">{press.founder.body}</p><a class="text-link" href={`mailto:${press.contact}`}>Talk to Noam ↗</a><aside class="article-link"><p class="eyebrow">Published in {press.article.publication}</p><h3><a href={press.article.url}>{press.article.title} ↗</a></h3><p>{press.article.description} {press.article.date}.</p></aside></div></div><div class="copy-section"><h3>Copyable app descriptions.</h3><div><div class="copy-label"><h4>Short description</h4><button data-copy="short-copy" type="button">Copy text</button></div><p id="short-copy">{press.shortDescription}</p></div><div><div class="copy-label"><h4>Extended description</h4><button data-copy="extended-copy" type="button">Copy text</button></div><p id="extended-copy">{press.extendedDescription}</p></div><p id="copy-status" class="micro" aria-live="polite"></p></div></section>
</main>
<footer class="press-footer"><div class="wrap"><a class="press-brand" href="/">DEE</a><p>Muay Thai, in your corner.<br/><a href={`mailto:${press.contact}`}>{press.contact}</a></p><nav aria-label="Footer"><a href="/">Home</a><a href="/press/" aria-current="page">Press</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/support/">Support</a></nav></div></footer>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
  const filter = button.dataset.filter;
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
  let count=0; document.querySelectorAll<HTMLElement>('[data-platform]').forEach(card=>{card.hidden=filter!=='All'&&card.dataset.platform!==filter;if(!card.hidden)count++});
  const status=document.getElementById('filter-status');if(status)status.textContent=`Showing ${count} ${filter==='All'?'':filter+' '}screenshots.`;
 }));
 document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{
  const text=document.getElementById(button.dataset.copy ?? '')?.textContent ?? '';const status=document.getElementById('copy-status');
  try {await navigator.clipboard.writeText(text);if(status)status.textContent='Description copied.';}catch{if(status)status.textContent='Select the description to copy it, or download the editorial text file.';}
 }));
</script>
</body></html>
