---
import { Image } from 'astro:assets'
import SiteHead from '@/components/SiteHead.astro'
import DownloadLinks from '@/components/DownloadLinks.astro'
import { campaignStoreURLs } from '@/lib/campaign-links.mjs'
import appIcon from '@/assets/dee/app-icon.png'
import androidHome from '@/assets/dee/paid/android-pixel-8a-home.png'
import pixelBezel from '@/assets/dee/devices/pixel-8a-back.webp'
import roundTimer from '@/assets/dee/paid/build33-round-timer.png'
import iphoneBezel from '@/assets/dee/devices/iphone-17-pro-max-deep-blue.png'
import '@/styles/dee.css'

export function getStaticPaths() {
  const pages = {
    meta_guess: {
      hook: 'Still deciding what to train?',
      source: 'meta', medium: 'paid_social', campaign: 'meta_guess',
    },
    meta_between: {
      hook: 'Training between classes?',
      source: 'meta', medium: 'paid_social', campaign: 'meta_between',
    },
    meta_heard: {
      hook: 'Hear every drill.',
      source: 'meta', medium: 'paid_social', campaign: 'meta_heard',
    },
    meta_audio_round_v1: {
      hook: 'Your round has a voice.',
      source: 'meta', medium: 'paid_social', campaign: 'meta_audio_round_v1',
    },
  } as const

  // Creator follower offers: one App Store offer code and one Google Play
  // promotion per creator, so each creator's redemptions can be counted.
  const creators = {
    nikita: {handle: 'nikita_parlevliet', code: 'NIKITA', validUntil: '3 May 2027'},
  } as const

  const campaignPaths = Object.entries(pages).map(([token, {hook, ...attribution}]) => ({
    params: {campaign: token},
    props: {hook, ...campaignStoreURLs({token, ...attribution})},
  }))

  const creatorPaths = Object.entries(creators).map(([slug, creator]) => {
    const token = `creator_${slug}`
    return {
      params: {campaign: slug},
      props: {
        hook: 'Your first month free',
        creator: {
          ...creator,
          redeemURL: `https://apps.apple.com/redeem?ctx=offercodes&id=6788483296&code=${creator.code}`,
        },
        ...campaignStoreURLs({token, source: 'instagram', medium: 'creator', campaign: token}),
      },
    }
  })

  return [...campaignPaths, ...creatorPaths]
}

interface CreatorOffer {
  handle: string
  code: string
  validUntil: string
  redeemURL: string
}

interface Props {
  hook: string
  appStoreURL: string
  googlePlayURL: string
  creator?: CreatorOffer
}

const { hook, appStoreURL, googlePlayURL, creator } = Astro.props as Props
const description = creator
  ? `Use code ${creator.code} for your first month of Dee Pro free. Dee is a Muay Thai coach for iPhone and Android, with personalised workouts, spoken drills and round cues.`
  : 'Dee is available on iOS and Android. Build your next solo Muay Thai session with Dee, then train with spoken drills, round cues, bells and haptics.'
---

<!doctype html>
<html lang="en-GB">
  <head>
    <SiteHead
      exactTitle={`${hook} | Dee`}
      description={description}
      canonical={Astro.url.pathname}
      robots="noindex,follow"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="campaign-topbar" data-download-header>
      <a class="campaign-topbar__brand" href="/" aria-label="Dee home"><Image src={appIcon} alt="" width={40} height={40} loading="eager" /><span>DEE</span></a>
      <DownloadLinks appStoreURL={appStoreURL} googlePlayURL={googlePlayURL} />
    </header>

    <main id="main" class="campaign-page">
      <section class="campaign-shell" aria-labelledby="campaign-title">
        <div class="copy-panel">
          {creator ? (
          <div class="copy-stack">
            <p class="eyebrow">For @{creator.handle}'s followers</p>
            <h1 id="campaign-title">{hook}</h1>
            <p class="proof-copy">Dee is your Muay Thai coach for solo training: personalised workouts, with spoken drills and round cues. Use code <strong>{creator.code}</strong> for your first month of Dee Pro free.</p>

            <div class="redeem-grid">
              <section class="redeem-card" aria-labelledby="redeem-iphone">
                <h2 id="redeem-iphone">On iPhone</h2>
                <a class="redeem-cta" href={creator.redeemURL} rel="noopener noreferrer">Claim your free month</a>
                <p>Confirm in the App Store, then open Dee.</p>
              </section>
              <section class="redeem-card" aria-labelledby="redeem-android">
                <h2 id="redeem-android">On Android</h2>
                <ol>
                  <li>Get Dee on Google Play.</li>
                  <li>In Dee, choose the yearly plan.</li>
                  <li>On the Google Play payment screen, tap the payment method, then <strong>Redeem code</strong>, and enter <strong>{creator.code}</strong>.</li>
                </ol>
                <a class="store-cta" href={googlePlayURL} aria-label="Get Dee on Google Play">
                  <img src="/badges/google-play.svg" alt="Get it on Google Play" width="162" height="48" />
                </a>
              </section>
            </div>
            <p class="offer-note">For new subscribers. Valid until {creator.validUntil}. After the free month, Dee Pro renews at the normal yearly price unless you cancel. You can cancel any time in your App Store or Google Play subscriptions.</p>
          </div>
          ) : (
          <div class="copy-stack">
            <p class="eyebrow">Your solo Muay Thai coach</p>
            <h1 id="campaign-title">{hook}</h1>
            <p class="proof-copy">Personalised Muay Thai workouts, with spoken drills and round cues.</p>

            <div class="actions">
              <a class="store-cta" href={appStoreURL} aria-label="Get Dee on the App Store">
                <img src="/badges/app-store.svg" alt="Download on the App Store" width="144" height="48" />
              </a>
              <a class="store-cta" href={googlePlayURL} aria-label="Get Dee on Google Play">
                <img src="/badges/google-play.svg" alt="Get it on Google Play" width="162" height="48" />
              </a>
            </div>
            <p class="offer-note">One free workout for new eligible iPhone users (iOS 26+). More workouts require a subscription.</p>
            <details class="offer-details">
              <summary>How the free workout works</summary>
              <p>No subscription starts automatically. Saving a finish, including an early finish, uses the free workout. Existing users keep their current access arrangements.</p>
            </details>
          </div>
          )}
        </div>

        <div class="product-panel" aria-label="Dee app interface">
          <div class="glow glow-one"></div>
          <div class="glow glow-two"></div>
          <figure class="phone phone-summary phone-android">
            <Image class="phone-bezel" src={pixelBezel} alt="" width={600} loading="eager" />
            <Image class="android-screen" src={androidHome} alt="Dee on Android: weekly training plan and start-session button" loading="eager" />
            <figcaption>Android</figcaption>
          </figure>
          <figure class="phone phone-round">
            <Image class="phone-screen" src={roundTimer} alt="Dee on iPhone: guided round timer" loading="eager" />
            <Image class="phone-bezel" src={iphoneBezel} alt="" width={588} loading="eager" />
            <figcaption>iPhone</figcaption>
          </figure>
        </div>
      </section>
    </main>

    <footer class="campaign-footer">
      <span>© 2026 Dee</span>
      <nav aria-label="Legal">
        <a href="/PrivacyPolicy/">Privacy</a>
        <a href="/TermsAndConditions/">Terms</a>
      </nav>
      <p>Dee provides general sport and fitness information, not medical advice.</p>
      <p class="store-credits">Apple, the Apple logo, iPhone and App Store are trademarks of Apple Inc., registered in the U.S. and other countries. Android, Google Pixel, Google Play and the Google Play logo are trademarks of Google LLC.</p>
    </footer>

    <style>
      :global(html) {
        background: #090d12;
        color-scheme: dark;
      }

      :global(body) {
        min-height: 100vh;
        background:
          radial-gradient(circle at 78% 12%, rgba(10, 158, 184, .16), transparent 32rem),
          linear-gradient(rgba(241, 244, 248, .035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(241, 244, 248, .035) 1px, transparent 1px),
          #090d12;
        background-size: auto, 48px 48px, 48px 48px, auto;
        color: var(--dee-paper);
      }

      .campaign-topbar {
        position: sticky;
        z-index: 50;
        top: 0;
        display: flex;
        min-height: 70px;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-bottom: 1px solid rgba(241, 244, 248, .17);
        background: rgba(9, 13, 18, .96);
        padding: 9px max(24px, calc((100vw - 1180px) / 2));
        backdrop-filter: blur(18px);
      }

      .campaign-topbar__brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--dee-paper);
        font: 900 1.5rem/1 'Barlow Condensed', sans-serif;
        letter-spacing: .1em;
        text-decoration: none;
      }

      .campaign-topbar__brand img { border-radius: 11px; }
      @media (max-width: 560px) {
        .campaign-topbar { min-height: 0; flex-wrap: wrap; justify-content: center; gap: 6px; padding: 8px 16px 10px; }
        .campaign-topbar__brand { width: 100%; }
        .campaign-topbar :global(.topbar-downloads) { justify-content: center; }
      }

      .campaign-page {
        display: grid;
        min-height: calc(100vh - 88px);
        place-items: center;
        padding: clamp(20px, 3vw, 40px);
      }

      .campaign-shell {
        position: relative;
        display: grid;
        width: min(1180px, 100%);
        min-height: min(660px, calc(100svh - 112px));
        grid-template-columns: minmax(0, 1.06fr) minmax(360px, .94fr);
        overflow: hidden;
        border: 1px solid rgba(241, 244, 248, .17);
        background: rgba(10, 15, 21, .92);
        box-shadow: 0 34px 110px rgba(0, 0, 0, .46);
      }

      .campaign-shell::before {
        position: absolute;
        z-index: 5;
        top: 0;
        right: 48%;
        left: 0;
        height: 4px;
        background: var(--dee-teal);
        content: '';
      }

      .copy-panel {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: clamp(24px, 3.4vw, 48px);
      }

      .copy-stack {
        margin-top: 0;
      }

      .eyebrow {
        margin: 0 0 12px;
        color: #82e1ee;
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 12ch;
        margin: 0;
        font: 900 clamp(3rem, 5.4vw, 5rem)/.9 'Barlow Condensed', sans-serif;
        letter-spacing: -.028em;
        text-transform: uppercase;
      }

      .proof-copy {
        max-width: 39rem;
        margin: 18px 0 0;
        color: rgba(241, 244, 248, .76);
        font-size: 1rem;
        line-height: 1.55;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
      }

      .store-cta {
        display: inline-flex;
        flex: 0 0 auto;
        border-radius: 7px;
      }

      .store-cta img {
        display: block;
        width: auto;
        height: 48px;
      }

      .store-cta:focus-visible {
        outline: 2px solid #82e1ee;
        outline-offset: 5px;
      }

      .offer-note,
      .offer-details {
        max-width: 35rem;
        color: rgba(241, 244, 248, .7);
        font-size: .8rem;
        line-height: 1.5;
      }

      .offer-note { margin: 16px 0 0; }
      .offer-details { margin-top: 8px; }
      .offer-details summary { width: fit-content; cursor: pointer; }
      .offer-details summary:focus-visible { outline: 2px solid #82e1ee; outline-offset: 4px; }
      .offer-details p { margin: 8px 0 0; }

      .proof-copy strong,
      .redeem-card strong {
        color: var(--dee-paper);
      }

      .redeem-grid {
        display: grid;
        max-width: 40rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-top: 24px;
      }

      .redeem-card {
        border: 1px solid rgba(241, 244, 248, .17);
        background: rgba(241, 244, 248, .035);
        padding: 16px 18px 18px;
      }

      .redeem-card h2 {
        margin: 0 0 12px;
        font: 800 1.15rem/1.1 'Barlow Condensed', sans-serif;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .redeem-card p,
      .redeem-card ol {
        margin: 12px 0 0;
        color: rgba(241, 244, 248, .76);
        font-size: .9rem;
        line-height: 1.5;
      }

      .redeem-card ol {
        padding-inline-start: 1.2em;
      }

      .redeem-card .store-cta {
        margin-top: 14px;
      }

      .redeem-card .store-cta img {
        height: 44px;
      }

      .redeem-cta {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: var(--dee-teal);
        color: var(--dee-ink);
        font-weight: 700;
        padding: 0 20px;
        text-decoration: none;
      }

      .redeem-cta:hover { background: #2bb7cf; }

      .redeem-cta:focus-visible {
        outline: 2px solid #82e1ee;
        outline-offset: 4px;
      }

      .product-panel {
        position: relative;
        min-width: 0;
        overflow: hidden;
        border-inline-start: 1px solid rgba(241, 244, 248, .13);
        background:
          linear-gradient(145deg, rgba(10, 158, 184, .2), transparent 44%),
          #121820;
      }

      .glow {
        position: absolute;
        border-radius: 999px;
        filter: blur(2px);
      }

      .glow-one {
        width: 360px;
        height: 360px;
        top: -140px;
        right: -120px;
        background: rgba(119, 114, 216, .28);
      }

      .glow-two {
        width: 300px;
        height: 300px;
        bottom: -130px;
        left: -110px;
        background: rgba(10, 158, 184, .25);
      }

      .phone {
        position: absolute;
        width: min(42%, 245px, 27vh);
        aspect-ratio: 1470 / 3000;
        margin: 0;
      }

      /* Native 1320 × 2868 screenshots fit the official frame's screen opening. */
      .phone-screen {
        position: absolute;
        top: 2.2%;
        left: 5.1020408163%;
        width: 89.7959183673%;
        height: 95.6%;
        border-radius: 14% / 6.5%;
      }

      .phone-bezel {
        position: relative;
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
      }

      .phone-android {
        aspect-ratio: 1198 / 2539;
      }

      /* Android Studio's Pixel 8a layout: 1080 × 2400 display at (57, 57). */
      .android-screen {
        position: absolute;
        left: 4.7579298831%;
        top: 2.2449783379%;
        width: 90.1502504174%;
        height: 94.5254037022%;
      }

      /* The frame already includes the glass edge, rounded corners and camera.
         Keep it above the screenshot; adding the emulator mask creates a second edge. */
      .phone-android .phone-bezel { z-index: 1; }

      .phone figcaption {
        position: absolute;
        top: calc(100% + 8px);
        width: 100%;
        color: rgba(241, 244, 248, .7);
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .1em;
        text-align: center;
      }

      .phone-summary {
        top: 9%;
        left: 6%;
      }

      .phone-round {
        right: 6%;
        bottom: 9%;
      }

      .campaign-footer {
        display: grid;
        width: min(1180px, calc(100% - 40px));
        grid-template-columns: auto auto 1fr;
        gap: 16px 28px;
        align-items: center;
        margin: 0 auto;
        padding: 2px 0 24px;
        color: rgba(241, 244, 248, .46);
        font-size: .72rem;
      }

      .campaign-footer nav {
        display: flex;
        gap: 18px;
      }

      .campaign-footer a {
        color: rgba(241, 244, 248, .7);
      }

      .campaign-footer p {
        margin: 0;
        text-align: right;
      }

      .campaign-footer .store-credits {
        grid-column: 1 / -1;
        text-align: left;
        line-height: 1.5;
      }

      @media (max-width: 820px) {
        .campaign-page {
          display: block;
          min-height: 0;
          padding: 0;
        }

        .campaign-shell {
          min-height: 0;
          grid-template-columns: 1fr;
          border: 0;
          box-shadow: none;
        }

        .campaign-shell::before { right: 0; }

        .copy-panel {
          padding: 22px 22px 28px;
        }

        .copy-stack {
          margin-top: 24px;
        }

        h1 {
          max-width: 12ch;
          font-size: clamp(2.75rem, 12vw, 4.25rem);
        }

        .proof-copy { margin-top: 16px; }

        .redeem-grid { grid-template-columns: 1fr; }

        .store-cta img { height: 44px; }

        .product-panel {
          min-height: clamp(400px, 115vw, 730px);
          border-block-start: 1px solid rgba(241, 244, 248, .13);
          border-inline-start: 0;
        }

        .phone {
          width: min(43%, 300px);
        }

        .phone-summary {
          top: 7%;
          left: 5%;
        }

        .phone-round {
          right: 5%;
          bottom: 7%;
        }

        .campaign-footer {
          grid-template-columns: auto 1fr;
          padding-top: 22px;
        }

        .campaign-footer p {
          grid-column: 1 / -1;
          text-align: left;
        }
      }

      @media (max-width: 359px) {
        .store-cta img { height: 40px; }
      }

      @media (max-width: 390px) {
        .copy-panel { padding-inline: 18px; }
      }

    </style>
  </body>
</html>
