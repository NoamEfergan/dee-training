---
import { Image } from 'astro:assets'
import SiteHead from '@/components/SiteHead.astro'
import appIcon from '@/assets/dee/app-icon.png'
import planSummary from '@/assets/dee/paid/build33-plan-summary.png'
import roundTimer from '@/assets/dee/paid/build33-round-timer.png'
import '@/styles/dee.css'

export function getStaticPaths() {
  const pages = {
    meta_guess: {
      hook: 'Still deciding what to train?',
      storeURL: 'https://apps.apple.com/app/id6788483296?pt=125910193&ct=meta_guess&mt=8&ppid=a8cbf41a-f2c2-4620-9142-4be86d24d96b',
    },
    meta_between: {
      hook: 'Training between classes?',
      storeURL: 'https://apps.apple.com/app/id6788483296?pt=125910193&ct=meta_between&mt=8&ppid=a8cbf41a-f2c2-4620-9142-4be86d24d96b',
    },
    meta_heard: {
      hook: 'Your next round should be heard, not searched for.',
      storeURL: 'https://apps.apple.com/app/id6788483296?pt=125910193&ct=meta_heard&mt=8&ppid=a8cbf41a-f2c2-4620-9142-4be86d24d96b',
    },
  } as const

  return Object.entries(pages).map(([campaign, props]) => ({
    params: { campaign },
    props,
  }))
}

interface Props {
  hook: string
  storeURL: string
}

const { hook, storeURL } = Astro.props as Props
const description = 'Build your next solo Muay Thai session with Dee, then train with spoken drills, round cues, bells and haptics.'
---

<!doctype html>
<html lang="en-GB">
  <head>
    <SiteHead
      exactTitle={`${hook} | Dee`}
      description={description}
      canonical={Astro.url.pathname}
      robots="noindex,follow"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main" class="campaign-page">
      <section class="campaign-shell" aria-labelledby="campaign-title">
        <div class="copy-panel">
          <a class="brand-lockup" href="/" aria-label="Dee home">
            <Image src={appIcon} alt="" width={52} height={52} loading="eager" />
            <span>DEE</span>
          </a>

          <div class="copy-stack">
            <p class="eyebrow">Muay Thai · Your session, built around you</p>
            <h1 id="campaign-title">{hook}</h1>
            <p class="proof-copy">
              Dee builds a training plan around your goals, level, weekly schedule and available equipment—then calls out drills and round transitions with spoken cues, bells and haptics.
            </p>

            <div class="actions">
              <a class="store-cta" href={storeURL} aria-label="Get Dee on the App Store">
                <span>Get Dee on the</span>
                <strong>App Store</strong>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="21" height="21">
                  <path d="M14.65 4.84c.68-.82 1.14-1.96 1.02-3.09-1 .04-2.22.67-2.93 1.49-.64.73-1.2 1.89-1.05 2.98 1.12.09 2.27-.57 2.96-1.38Zm2.49 7.92c-.02-2.33 1.9-3.46 1.98-3.52a4.24 4.24 0 0 0-3.34-1.81c-1.4-.15-2.76.84-3.47.84-.73 0-1.83-.82-3.02-.79a4.43 4.43 0 0 0-3.73 2.27c-1.61 2.78-.41 6.87 1.13 9.12.77 1.1 1.67 2.33 2.86 2.28 1.16-.05 1.6-.73 3-.73 1.39 0 1.8.73 3.01.7 1.25-.02 2.04-1.1 2.78-2.21a9.1 9.1 0 0 0 1.27-2.59 4.05 4.05 0 0 1-2.47-3.72Z" />
                </svg>
              </a>
              <span class="release-note">Real Dee interface · Version 1.0.6</span>
            </div>
          </div>

          <div class="evidence-strip" aria-label="Dee product features">
            <span>Personalised plan</span>
            <span>Spoken cues</span>
            <span>Round timer</span>
          </div>
        </div>

        <div class="product-panel" aria-label="Dee app interface">
          <div class="glow glow-one"></div>
          <div class="glow glow-two"></div>
          <figure class="phone phone-summary">
            <Image src={planSummary} alt="Dee personalised session summary" loading="eager" />
          </figure>
          <figure class="phone phone-round">
            <Image src={roundTimer} alt="Dee guided round timer" loading="eager" />
          </figure>
          <div class="round-badge" aria-hidden="true">
            <span>01</span>
            <strong>ROUND</strong>
          </div>
        </div>
      </section>
    </main>

    <footer class="campaign-footer">
      <span>© 2026 Dee</span>
      <nav aria-label="Legal">
        <a href="/PrivacyPolicy/">Privacy</a>
        <a href="/TermsAndConditions/">Terms</a>
      </nav>
      <p>Dee provides general sport and fitness information, not medical advice.</p>
    </footer>

    <style>
      :global(html) {
        background: #090d12;
        color-scheme: dark;
      }

      :global(body) {
        min-height: 100vh;
        background:
          radial-gradient(circle at 78% 12%, rgba(10, 158, 184, .16), transparent 32rem),
          linear-gradient(rgba(241, 244, 248, .035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(241, 244, 248, .035) 1px, transparent 1px),
          #090d12;
        background-size: auto, 48px 48px, 48px 48px, auto;
        color: var(--dee-paper);
      }

      .campaign-page {
        display: grid;
        min-height: calc(100vh - 88px);
        place-items: center;
        padding: clamp(20px, 4vw, 58px);
      }

      .campaign-shell {
        position: relative;
        display: grid;
        width: min(1180px, 100%);
        min-height: min(760px, calc(100vh - 116px));
        grid-template-columns: minmax(0, 1.06fr) minmax(360px, .94fr);
        overflow: hidden;
        border: 1px solid rgba(241, 244, 248, .17);
        background: rgba(10, 15, 21, .92);
        box-shadow: 0 34px 110px rgba(0, 0, 0, .46);
      }

      .campaign-shell::before {
        position: absolute;
        z-index: 5;
        top: 0;
        right: 48%;
        left: 0;
        height: 4px;
        background: var(--dee-teal);
        content: '';
      }

      .copy-panel {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(28px, 6vw, 76px);
      }

      .brand-lockup {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 13px;
        color: var(--dee-paper);
        font: 900 1.7rem/1 'Barlow Condensed', sans-serif;
        letter-spacing: .13em;
        text-decoration: none;
      }

      .brand-lockup img {
        border-radius: 14px;
        box-shadow: 0 10px 28px rgba(0, 0, 0, .3);
      }

      .copy-stack {
        margin-block: clamp(58px, 9vh, 98px) clamp(42px, 7vh, 78px);
      }

      .eyebrow {
        margin: 0 0 18px;
        color: #82e1ee;
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 10.5ch;
        margin: 0;
        font: 900 clamp(4rem, 7vw, 7rem)/.82 'Barlow Condensed', sans-serif;
        letter-spacing: -.028em;
        text-transform: uppercase;
      }

      .proof-copy {
        max-width: 39rem;
        margin: 30px 0 0;
        color: rgba(241, 244, 248, .76);
        font-size: clamp(1.03rem, 1.5vw, 1.18rem);
        line-height: 1.55;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px 22px;
        margin-top: 34px;
      }

      .store-cta {
        position: relative;
        display: grid;
        min-width: 210px;
        min-height: 62px;
        grid-template-columns: 1fr auto;
        grid-template-rows: auto auto;
        align-content: center;
        padding: 10px 17px 10px 19px;
        background: var(--dee-paper);
        color: #090d12;
        text-decoration: none;
        transition: background 160ms ease, transform 160ms ease;
      }

      .store-cta span {
        font-size: .69rem;
        line-height: 1;
      }

      .store-cta strong {
        font-size: 1.27rem;
        line-height: 1.1;
      }

      .store-cta svg {
        grid-column: 2;
        grid-row: 1 / 3;
        align-self: center;
        fill: currentColor;
      }

      .store-cta:hover,
      .store-cta:focus-visible {
        background: #82e1ee;
        transform: translateY(-2px);
      }

      .release-note {
        color: rgba(241, 244, 248, .56);
        font-size: .78rem;
        letter-spacing: .04em;
      }

      .evidence-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 28px;
        padding-top: 22px;
        border-top: 1px solid rgba(241, 244, 248, .13);
        color: rgba(241, 244, 248, .58);
        font-size: .75rem;
        font-weight: 600;
        letter-spacing: .12em;
        text-transform: uppercase;
      }

      .product-panel {
        position: relative;
        min-width: 0;
        overflow: hidden;
        border-inline-start: 1px solid rgba(241, 244, 248, .13);
        background:
          linear-gradient(145deg, rgba(10, 158, 184, .2), transparent 44%),
          #121820;
      }

      .glow {
        position: absolute;
        border-radius: 999px;
        filter: blur(2px);
      }

      .glow-one {
        width: 360px;
        height: 360px;
        top: -140px;
        right: -120px;
        background: rgba(119, 114, 216, .28);
      }

      .glow-two {
        width: 300px;
        height: 300px;
        bottom: -130px;
        left: -110px;
        background: rgba(10, 158, 184, .25);
      }

      .phone {
        position: absolute;
        margin: 0;
        overflow: hidden;
        border: 7px solid #07090c;
        border-radius: 35px;
        background: #07090c;
        box-shadow: 0 30px 72px rgba(0, 0, 0, .5);
      }

      .phone img {
        display: block;
        width: 100%;
        height: auto;
      }

      .phone-summary {
        z-index: 2;
        width: min(54%, 282px);
        top: 11%;
        left: 8%;
        transform: rotate(-6deg);
      }

      .phone-round {
        z-index: 3;
        width: min(58%, 304px);
        right: 6%;
        bottom: 8%;
        transform: rotate(5deg);
      }

      .round-badge {
        position: absolute;
        z-index: 4;
        right: 8%;
        top: 10%;
        display: grid;
        width: 92px;
        height: 92px;
        place-content: center;
        border: 1px solid rgba(130, 225, 238, .5);
        background: rgba(6, 18, 23, .84);
        color: #82e1ee;
        text-align: center;
        backdrop-filter: blur(12px);
      }

      .round-badge span {
        font: 900 2.25rem/.9 'Barlow Condensed', sans-serif;
      }

      .round-badge strong {
        margin-top: 4px;
        font-size: .58rem;
        letter-spacing: .18em;
      }

      .campaign-footer {
        display: grid;
        width: min(1180px, calc(100% - 40px));
        grid-template-columns: auto auto 1fr;
        gap: 16px 28px;
        align-items: center;
        margin: 0 auto;
        padding: 2px 0 24px;
        color: rgba(241, 244, 248, .46);
        font-size: .72rem;
      }

      .campaign-footer nav {
        display: flex;
        gap: 18px;
      }

      .campaign-footer a {
        color: rgba(241, 244, 248, .7);
      }

      .campaign-footer p {
        margin: 0;
        text-align: right;
      }

      @media (max-width: 820px) {
        .campaign-page {
          display: block;
          min-height: 0;
          padding: 0;
        }

        .campaign-shell {
          min-height: 0;
          grid-template-columns: 1fr;
          border: 0;
          box-shadow: none;
        }

        .campaign-shell::before { right: 0; }

        .copy-panel {
          padding: 24px 22px 36px;
        }

        .copy-stack {
          margin-block: 64px 38px;
        }

        h1 {
          max-width: 9.5ch;
          font-size: clamp(3.75rem, 17vw, 6rem);
        }

        .proof-copy { margin-top: 24px; }

        .actions {
          align-items: flex-start;
          flex-direction: column;
        }

        .evidence-strip {
          gap: 10px 18px;
        }

        .product-panel {
          min-height: 580px;
          border-block-start: 1px solid rgba(241, 244, 248, .13);
          border-inline-start: 0;
        }

        .phone-summary {
          width: min(56vw, 244px);
          top: 8%;
          left: 5%;
        }

        .phone-round {
          width: min(61vw, 264px);
          right: 4%;
          bottom: 5%;
        }

        .round-badge {
          right: 5%;
          top: 7%;
        }

        .campaign-footer {
          grid-template-columns: auto 1fr;
          padding-top: 22px;
        }

        .campaign-footer p {
          grid-column: 1 / -1;
          text-align: left;
        }
      }

      @media (max-width: 390px) {
        .copy-panel { padding-inline: 18px; }
        .product-panel { min-height: 520px; }
        .round-badge { width: 78px; height: 78px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .store-cta { transition: none; }
      }
    </style>
  </body>
</html>
