---
import { Image } from 'astro:assets'
import { deeAvailability } from '@/content/content'
import SiteHead from '@/components/SiteHead.astro'
import appIcon from '@/assets/dee/app-icon.png'
import androidHome from '@/assets/dee/paid/android-pixel-8a-home.png'
import pixelBezel from '@/assets/dee/devices/pixel-8a-back.webp'
import roundTimer from '@/assets/dee/paid/build33-round-timer.png'
import iphoneBezel from '@/assets/dee/devices/iphone-17-pro-max-deep-blue.png'
import '@/styles/dee.css'

export function getStaticPaths() {
  const pages = {
    meta_guess: {
      hook: 'Still deciding what to train?',
      storeURL: 'https://apps.apple.com/app/id6788483296?pt=125910193&ct=meta_guess&mt=8&ppid=a8cbf41a-f2c2-4620-9142-4be86d24d96b',
    },
    meta_between: {
      hook: 'Training between classes?',
      storeURL: 'https://apps.apple.com/app/id6788483296?pt=125910193&ct=meta_between&mt=8&ppid=a8cbf41a-f2c2-4620-9142-4be86d24d96b',
    },
    meta_heard: {
      hook: 'Hear every drill.',
      storeURL: 'https://apps.apple.com/app/id6788483296?pt=125910193&ct=meta_heard&mt=8&ppid=a8cbf41a-f2c2-4620-9142-4be86d24d96b',
    },
    meta_audio_round_v1: {
      hook: 'Your round has a voice.',
      storeURL: 'https://apps.apple.com/app/id6788483296?pt=125910193&ct=meta_audio_round_v1&mt=8&ppid=a8cbf41a-f2c2-4620-9142-4be86d24d96b',
    },
  } as const

  return Object.entries(pages).map(([campaign, props]) => ({
    params: { campaign },
    props,
  }))
}

interface Props {
  hook: string
  storeURL: string
}

const { hook, storeURL } = Astro.props as Props
const description = 'Dee is available on iOS and Android. Build your next solo Muay Thai session with Dee, then train with spoken drills, round cues, bells and haptics.'
---

<!doctype html>
<html lang="en-GB">
  <head>
    <SiteHead
      exactTitle={`${hook} | Dee`}
      description={description}
      canonical={Astro.url.pathname}
      robots="noindex,follow"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main" class="campaign-page">
      <section class="campaign-shell" aria-labelledby="campaign-title">
        <div class="copy-panel">
          <a class="brand-lockup" href="/" aria-label="Dee home">
            <Image src={appIcon} alt="" width={40} height={40} loading="eager" />
            <span>DEE</span>
          </a>

          <div class="copy-stack">
            <p class="eyebrow">Your solo Muay Thai coach</p>
            <h1 id="campaign-title">{hook}</h1>
            <p class="proof-copy">Personalised Muay Thai workouts, with spoken drills and round cues.</p>

            <div class="actions">
              <a class="store-cta" href={storeURL} aria-label="Get Dee on the App Store">
                <img src="/badges/app-store.svg" alt="Download on the App Store" width="144" height="48" />
              </a>
              <a class="store-cta" href={deeAvailability.googlePlayURL} aria-label="Get Dee on Google Play">
                <img src="/badges/google-play.svg" alt="Get it on Google Play" width="162" height="48" />
              </a>
            </div>
            <p class="offer-note">One free workout for new eligible iPhone users (iOS 26+). More workouts require a subscription.</p>
            <details class="offer-details">
              <summary>How the free workout works</summary>
              <p>No subscription starts automatically. Saving a finish, including an early finish, uses the free workout. Existing users keep their current access arrangements.</p>
            </details>
          </div>
        </div>

        <div class="product-panel" aria-label="Dee app interface">
          <div class="glow glow-one"></div>
          <div class="glow glow-two"></div>
          <figure class="phone phone-summary phone-android">
            <Image class="phone-bezel" src={pixelBezel} alt="" width={600} loading="eager" />
            <Image class="android-screen" src={androidHome} alt="Dee on Android: weekly training plan and start-session button" loading="eager" />
            <figcaption>Android</figcaption>
          </figure>
          <figure class="phone phone-round">
            <Image class="phone-screen" src={roundTimer} alt="Dee on iPhone: guided round timer" loading="eager" />
            <Image class="phone-bezel" src={iphoneBezel} alt="" width={588} loading="eager" />
            <figcaption>iPhone</figcaption>
          </figure>
        </div>
      </section>
    </main>

    <footer class="campaign-footer">
      <span>© 2026 Dee</span>
      <nav aria-label="Legal">
        <a href="/PrivacyPolicy/">Privacy</a>
        <a href="/TermsAndConditions/">Terms</a>
      </nav>
      <p>Dee provides general sport and fitness information, not medical advice.</p>
      <p class="store-credits">Apple, the Apple logo, iPhone and App Store are trademarks of Apple Inc., registered in the U.S. and other countries. Android, Google Pixel, Google Play and the Google Play logo are trademarks of Google LLC.</p>
    </footer>

    <style>
      :global(html) {
        background: #090d12;
        color-scheme: dark;
      }

      :global(body) {
        min-height: 100vh;
        background:
          radial-gradient(circle at 78% 12%, rgba(10, 158, 184, .16), transparent 32rem),
          linear-gradient(rgba(241, 244, 248, .035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(241, 244, 248, .035) 1px, transparent 1px),
          #090d12;
        background-size: auto, 48px 48px, 48px 48px, auto;
        color: var(--dee-paper);
      }

      .campaign-page {
        display: grid;
        min-height: calc(100vh - 88px);
        place-items: center;
        padding: clamp(20px, 3vw, 40px);
      }

      .campaign-shell {
        position: relative;
        display: grid;
        width: min(1180px, 100%);
        min-height: min(660px, calc(100svh - 112px));
        grid-template-columns: minmax(0, 1.06fr) minmax(360px, .94fr);
        overflow: hidden;
        border: 1px solid rgba(241, 244, 248, .17);
        background: rgba(10, 15, 21, .92);
        box-shadow: 0 34px 110px rgba(0, 0, 0, .46);
      }

      .campaign-shell::before {
        position: absolute;
        z-index: 5;
        top: 0;
        right: 48%;
        left: 0;
        height: 4px;
        background: var(--dee-teal);
        content: '';
      }

      .copy-panel {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: clamp(24px, 3.4vw, 48px);
      }

      .brand-lockup {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 13px;
        color: var(--dee-paper);
        font: 900 1.7rem/1 'Barlow Condensed', sans-serif;
        letter-spacing: .13em;
        text-decoration: none;
      }

      .brand-lockup img {
        border-radius: 14px;
        box-shadow: 0 10px 28px rgba(0, 0, 0, .3);
      }

      .copy-stack {
        margin-top: 28px;
      }

      .eyebrow {
        margin: 0 0 12px;
        color: #82e1ee;
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 12ch;
        margin: 0;
        font: 900 clamp(3rem, 5.4vw, 5rem)/.9 'Barlow Condensed', sans-serif;
        letter-spacing: -.028em;
        text-transform: uppercase;
      }

      .proof-copy {
        max-width: 39rem;
        margin: 18px 0 0;
        color: rgba(241, 244, 248, .76);
        font-size: 1rem;
        line-height: 1.55;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
      }

      .store-cta {
        display: inline-flex;
        flex: 0 0 auto;
        border-radius: 7px;
      }

      .store-cta img {
        display: block;
        width: auto;
        height: 48px;
      }

      .store-cta:focus-visible {
        outline: 2px solid #82e1ee;
        outline-offset: 5px;
      }

      .offer-note,
      .offer-details {
        max-width: 35rem;
        color: rgba(241, 244, 248, .7);
        font-size: .8rem;
        line-height: 1.5;
      }

      .offer-note { margin: 16px 0 0; }
      .offer-details { margin-top: 8px; }
      .offer-details summary { width: fit-content; cursor: pointer; }
      .offer-details summary:focus-visible { outline: 2px solid #82e1ee; outline-offset: 4px; }
      .offer-details p { margin: 8px 0 0; }

      .product-panel {
        position: relative;
        min-width: 0;
        overflow: hidden;
        border-inline-start: 1px solid rgba(241, 244, 248, .13);
        background:
          linear-gradient(145deg, rgba(10, 158, 184, .2), transparent 44%),
          #121820;
      }

      .glow {
        position: absolute;
        border-radius: 999px;
        filter: blur(2px);
      }

      .glow-one {
        width: 360px;
        height: 360px;
        top: -140px;
        right: -120px;
        background: rgba(119, 114, 216, .28);
      }

      .glow-two {
        width: 300px;
        height: 300px;
        bottom: -130px;
        left: -110px;
        background: rgba(10, 158, 184, .25);
      }

      .phone {
        position: absolute;
        width: min(42%, 245px, 27vh);
        aspect-ratio: 1470 / 3000;
        margin: 0;
      }

      /* Native 1320 × 2868 screenshots fit the official frame's screen opening. */
      .phone-screen {
        position: absolute;
        top: 2.2%;
        left: 5.1020408163%;
        width: 89.7959183673%;
        height: 95.6%;
        border-radius: 14% / 6.5%;
      }

      .phone-bezel {
        position: relative;
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
      }

      .phone-android {
        aspect-ratio: 1198 / 2539;
      }

      /* Android Studio's Pixel 8a layout: 1080 × 2400 display at (57, 57). */
      .android-screen {
        position: absolute;
        left: 4.7579298831%;
        top: 2.2449783379%;
        width: 90.1502504174%;
        height: 94.5254037022%;
      }

      /* The frame already includes the glass edge, rounded corners and camera.
         Keep it above the screenshot; adding the emulator mask creates a second edge. */
      .phone-android .phone-bezel { z-index: 1; }

      .phone figcaption {
        position: absolute;
        top: calc(100% + 8px);
        width: 100%;
        color: rgba(241, 244, 248, .7);
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .1em;
        text-align: center;
      }

      .phone-summary {
        top: 9%;
        left: 6%;
      }

      .phone-round {
        right: 6%;
        bottom: 9%;
      }

      .campaign-footer {
        display: grid;
        width: min(1180px, calc(100% - 40px));
        grid-template-columns: auto auto 1fr;
        gap: 16px 28px;
        align-items: center;
        margin: 0 auto;
        padding: 2px 0 24px;
        color: rgba(241, 244, 248, .46);
        font-size: .72rem;
      }

      .campaign-footer nav {
        display: flex;
        gap: 18px;
      }

      .campaign-footer a {
        color: rgba(241, 244, 248, .7);
      }

      .campaign-footer p {
        margin: 0;
        text-align: right;
      }

      .campaign-footer .store-credits {
        grid-column: 1 / -1;
        text-align: left;
        line-height: 1.5;
      }

      @media (max-width: 820px) {
        .campaign-page {
          display: block;
          min-height: 0;
          padding: 0;
        }

        .campaign-shell {
          min-height: 0;
          grid-template-columns: 1fr;
          border: 0;
          box-shadow: none;
        }

        .campaign-shell::before { right: 0; }

        .copy-panel {
          padding: 22px 22px 28px;
        }

        .copy-stack {
          margin-top: 24px;
        }

        h1 {
          max-width: 12ch;
          font-size: clamp(2.75rem, 12vw, 4.25rem);
        }

        .proof-copy { margin-top: 16px; }

        .store-cta img { height: 44px; }

        .product-panel {
          min-height: clamp(400px, 115vw, 730px);
          border-block-start: 1px solid rgba(241, 244, 248, .13);
          border-inline-start: 0;
        }

        .phone {
          width: min(43%, 300px);
        }

        .phone-summary {
          top: 7%;
          left: 5%;
        }

        .phone-round {
          right: 5%;
          bottom: 7%;
        }

        .campaign-footer {
          grid-template-columns: auto 1fr;
          padding-top: 22px;
        }

        .campaign-footer p {
          grid-column: 1 / -1;
          text-align: left;
        }
      }

      @media (max-width: 359px) {
        .store-cta img { height: 40px; }
      }

      @media (max-width: 390px) {
        .copy-panel { padding-inline: 18px; }
      }

    </style>
  </body>
</html>
