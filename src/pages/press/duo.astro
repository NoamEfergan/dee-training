---
import SiteHead from '@/components/SiteHead.astro'
import PressHeader from '@/components/PressHeader.astro'
import PressFooter from '@/components/PressFooter.astro'
import DuoDevice from '@/components/DuoDevice.astro'
import press from '@/content/press.json'
import '@/styles/dee.css'
import '@/styles/press.css'
---
<!doctype html>
<html lang="en-GB">
<head>
  <SiteHead exactTitle="Dee on iPhone Duo — beside the mat" description="Your Muay Thai corner beside the mat. A landscape workout preview for Duo’s outer display, with a live simulator demo." image={{src:'/press/duo/round-timer.jpg',alt:'Dee’s landscape workout on Duo’s outer display'}} />
  <link rel="preload" href="/fonts/barlow-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/barlow-condensed-black.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body class="press-page">
<a class="skip-link" href="#main">Skip to content</a>
<PressHeader />
<main id="main">
  <section class="press-hero duo-hero wrap" aria-labelledby="duo-title">
    <div>
      <p class="eyebrow">iPhone Duo / Workout preview</p>
      <h1 id="duo-title">Your corner.<br /><em>Beside<br />the mat.</em></h1>
      <p class="intro">Prop up Duo. See your round, follow your next drill, and keep your hands free to train.</p>
      <div class="action-row"><a class="press-button" href="#live">Watch the workout <span aria-hidden="true">↓</span></a><a class="text-link" href="/press/">Full Dee press kit ↗</a></div>
      <p class="micro">Dee 1.0.12 · release preview<br />Captured in the iOS 27.1 simulator.</p>
    </div>
    <figure>
      <div class="hero-art duo-art">
        <span class="art-label">BUILT FOR THE ROUND</span>
        <DuoDevice><img src="/press/duo/round-timer.jpg" width="2034" height="1398" fetchpriority="high" alt="Dee’s landscape workout: 02:45 remaining, shadowboxing, next rest, and pause controls" /></DuoDevice>
        <span class="art-foot">iPhone Duo / Outer display</span>
      </div>
      <figcaption class="duo-caption">Actual Dee capture in Apple’s official frame. Front view; the tent angle is not shown.</figcaption>
    </figure>
  </section>
  <section class="wrap duo-benefits" aria-label="Workout benefits">
    <div class="story-grid">
      <article><span class="story-number">01</span><h2>See your round.</h2><p>The timer and current drill sit together in landscape, with coaching detail alongside.</p></article>
      <article><span class="story-number">02</span><h2>Keep your flow.</h2><p>Pause, skip, or finish while longer instructions scroll in their own area. Your controls stay in reach.</p></article>
      <article><span class="story-number">03</span><h2>Stay with it.</h2><p>The display stays awake while you train, so the next glance is all you need.</p></article>
    </div>
  </section>
  <section class="watch-section duo-demo" id="live" aria-labelledby="live-title">
    <div class="wrap duo-demo-grid">
      <div>
        <p class="eyebrow">Inside the working app</p>
        <h2 id="live-title">Real rounds.<br /><em>Real countdown.</em></h2>
        <p class="intro">Watch a short sample workout count down from work into recovery on Duo’s outer display.</p>
        <p class="micro">31 seconds · live workout clock<br />Simulator recording · no audio</p>
        <a class="text-link" href="/press/duo/live-workout-landscape.mp4" download>Download the original MP4 ↓</a>
      </div>
      <figure>
        <DuoDevice>
          <video controls playsinline preload="metadata" poster="/press/duo/live-workout-start.jpg" aria-label="Live landscape workout transitioning into recovery">
            <source src="/press/duo/live-workout-landscape.mp4" type="video/mp4" />
            <track kind="captions" src="/press/duo/live-workout-landscape.vtt" srclang="en" label="English" />
            <p><a href="/press/duo/live-workout-landscape.mp4">Download the workout video</a></p>
          </video>
        </DuoDevice>
        <figcaption class="duo-caption">The working app, in Apple’s official outer-display frame. The video runs on the live clock; the hero still uses a frozen timer.</figcaption>
      </figure>
    </div>
  </section>
  <section class="wrap section duo-review" aria-labelledby="review-title">
    <div>
      <p class="eyebrow">Take it for a round</p>
      <h2 id="review-title">In your corner.</h2>
      <p class="intro">Dee is an independent Muay Thai training app by Noam Efergan. Get the full story, explore the app, or get in touch for a walkthrough.</p>
      <div class="action-row"><a class="press-button" href={`mailto:${press.contact}?subject=Dee%20Duo%20review`}>Request review access ↗</a><a class="text-link" href="/press/">Explore the press kit ↗</a></div>
    </div>
    <aside class="duo-notes" aria-label="Preview details">
      <p class="eyebrow">About this preview</p>
      <p>The landscape workout is a preview of Dee 1.0.12. Release timing depends on Apple’s supported build tools and App Review.</p>
      <p>Landscape behaviour is verified in the simulator. Physical tent posture, outer-display handoff, and audio on a real Duo still need a hardware check. Dee adapts to landscape orientation; it does not detect the hinge angle.</p>
      <p class="micro">Frame: <a href="https://developer.apple.com/design/resources/#product-bezels">Apple Design Resources</a><br />Captures: Dee / Noam Efergan · 22 September 2026</p>
    </aside>
  </section>
</main>
<PressFooter />
</body>
</html>
<style>
  .duo-hero { grid-template-columns: .92fr 1.08fr; gap: 54px; }
  .duo-hero h1 { font-size: clamp(76px, 7.7vw, 106px); }
  .duo-hero .intro { max-width: 33ch; }
  .duo-art { height: 510px; padding: 30px 14px; }
  .duo-art :global(.duo-device) { position: relative; z-index: 1; }
  .duo-caption { margin-top: 17px; color: var(--dee-muted); font-size: 13px; line-height: 1.55; max-width: 580px; }
  .duo-benefits { padding-bottom: 80px; }
  .duo-benefits h2 { font-size: 35px; font-weight: 700; margin: 0 0 18px; }
  .duo-benefits .story-number { margin-bottom: 22px; }
  .duo-demo { scroll-margin-top: 0; }
  .duo-demo-grid { display: grid; grid-template-columns: .72fr 1.28fr; gap: 60px; align-items: center; }
  .duo-demo h2 { font-size: clamp(48px, 4.8vw, 64px); }
  .duo-demo .duo-caption { color: #b4c2d1; }
  .duo-demo .text-link { color: #63d7df; }
  .duo-review { display: grid; grid-template-columns: 1.1fr .9fr; gap: 80px; align-items: start; }
  .duo-review h2 { font-size: clamp(48px, 5.5vw, 72px); margin: 18px 0 24px; }
  .duo-notes { border-top: 2px solid var(--dee-ink); padding-top: 23px; }
  .duo-notes > p:not(.eyebrow) { font-size: 15px; color: var(--dee-muted); }
  @media (max-width: 1000px) {
    .duo-hero { gap: 30px; }
    .duo-art { height: 450px; padding-inline: 8px; }
    .duo-demo-grid { gap: 30px; }
    .duo-review { gap: 40px; }
  }
  @media (max-width: 700px) {
    .duo-hero { grid-template-columns: 1fr; gap: 25px; }
    .duo-hero h1 { font-size: clamp(58px, 16vw, 82px); }
    .duo-art { height: auto; min-height: 300px; padding: 55px 10px; }
    .duo-benefits { padding-bottom: 55px; }
    .duo-demo-grid, .duo-review { grid-template-columns: 1fr; gap: 35px; }
    .duo-demo h2 { font-size: 52px; }
    .duo-demo .intro { max-width: 35ch; }
  }
</style>
