---
import SiteHead from '@/components/SiteHead.astro'
import '@/styles/dee.css'
import '@/styles/press.css'
const pairs = [
 {title:'One session. More room to train.',body:'The cover display focuses on the current interval. Opened, the timer, drill guidance and controls sit side by side. A live sample workout was checked across closed, opened and Book poses without losing its progression.',closed:'workout-closed.png',opened:'workout-opened.png'},
 {title:'The value and the price, together.',body:'The subscription screen adapts to the available space. Both displays show the benefits, plan prices and subscribe button together at the default text size. Larger accessibility text uses a readable scrolling layout.',closed:'paywall-closed.png',opened:'paywall-opened.png'}
]
---
<!doctype html><html lang="en-GB"><head><SiteHead exactTitle="Dee on iPhone Duo — press preview" description="A Muay Thai corner that unfolds with your training. Screenshots and a live-clock simulator demo of Dee on iPhone Duo." image={{src:'/press/duo/workout-opened.png',alt:'Dee workout on the opened iPhone Duo display'}} /></head>
<body class="press-page"><header class="press-header"><a class="press-brand" href="/press/"><img src="/press/assets/dee-app-icon.png" width="42" height="42" alt=""/><span>DEE</span></a><span class="eyebrow">iPhone Duo preview</span><a href="mailto:noamifergan@gmail.com">Talk to Noam ↗</a></header>
<main class="wrap duo-main"><section class="duo-intro"><p class="eyebrow">Built for the round · 22 September 2026</p><h1>Your corner,<br/><em>unfolded.</em></h1><p class="intro">Put the phone down. See the next drill. Keep training. Dee brings its Muay Thai session to both iPhone Duo displays, giving the timer and guidance room to work together.</p><p class="duo-status"><strong>Preview of Dee 1.0.12.</strong> Planned for release as soon as App Review approves it. The current App Store version is 1.0.11. These are iOS 27.1 simulator captures with sample data.</p><div class="action-row"><a class="press-button" href="#demo">Watch the workout ↓</a><a class="text-link" href="/press/">Full Dee press kit ↗</a></div></section>
{pairs.map(pair=><section class="duo-section"><h2>{pair.title}</h2><p class="intro">{pair.body}</p><div class="duo-pair"><figure class="duo-closed"><a href={`/press/duo/${pair.closed}`} download><img src={`/press/duo/${pair.closed}`} alt={`${pair.title} Closed iPhone Duo display.`} loading="lazy"/></a><figcaption>Closed display · <a href={`/press/duo/${pair.closed}`} download>Original PNG ↓</a></figcaption></figure><figure class="duo-opened"><a href={`/press/duo/${pair.opened}`} download><img src={`/press/duo/${pair.opened}`} alt={`${pair.title} Opened iPhone Duo display.`} loading="lazy"/></a><figcaption>Opened display · <a href={`/press/duo/${pair.opened}`} download>Original PNG ↓</a></figcaption></figure></div></section>)}
<section class="duo-section" id="demo"><p class="eyebrow">30 seconds in the round</p><h2>A workout on its live clock.</h2><p class="intro">Watch Dee move from a work interval into recovery on the opened display.</p><video controls playsinline preload="metadata" poster="/press/duo/workout-opened.png" aria-label="Dee live workout on iPhone Duo"><source src="/press/duo/workout-demo.mp4" type="video/mp4"/><track default kind="captions" src="/press/duo/workout-demo.vtt" srclang="en" label="English"/></video><p class="micro">30-second simulator recording with sample data and no audio. This clip shows the opened display; the fold/unfold continuity check was performed separately. Physical-device audio and haptics have not yet been verified.</p><a class="text-link" href="/press/duo/workout-demo.mp4" download>Download the original MP4 ↓</a></section>
<section class="duo-section duo-review"><h2>Take it for a round.</h2><p class="intro">Dee is an independent Muay Thai training app built by Noam Efergan for his own practice. It combines personalized plans, spoken coaching, bells and saved workout playback. Saved workouts play offline; plan generation may use an online service.</p><p>For review access or a short walkthrough, <a href="mailto:noamifergan@gmail.com?subject=Dee%20iPhone%20Duo%20review">email Noam</a>. These assets are available for editorial coverage of Dee. Credit: Dee / Noam Efergan. Please label images as simulator captures.</p><div class="action-row"><a class="press-button" href="https://apps.apple.com/app/apple-store/id6788483296">Dee on the App Store ↗</a><a class="text-link" href="/press/">App facts, Watch demo and creator story ↗</a></div></section></main>
<footer class="press-footer"><div class="wrap"><a class="press-brand" href="/press/">DEE</a><p>Muay Thai, in your corner.</p><a href="/privacy/">Privacy</a></div></footer>
<style>
.duo-main{padding-top:80px}.duo-intro{max-width:880px}.duo-intro h1{font-size:clamp(4rem,10vw,8rem);line-height:.92;margin:24px 0}.duo-intro em{color:var(--dee-teal-dark)}.duo-status{border-left:3px solid currentColor;padding:14px 20px;max-width:720px;line-height:1.6;opacity:.85}.duo-section{padding:76px 0;border-top:1px solid var(--dee-line);margin-top:60px;scroll-margin-top:30px}.duo-section h2{font-size:clamp(2.5rem,5vw,4.5rem);max-width:850px}.duo-section>.intro{max-width:820px}.duo-pair{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);align-items:center;gap:36px;margin-top:40px}.duo-pair figure{margin:0;min-width:0}.duo-pair img{display:block;width:100%;height:auto;border:1px solid var(--dee-line);border-radius:12px}.duo-pair figcaption{margin-top:14px;font-size:.85rem;line-height:1.7;opacity:.8}.duo-section video{display:block;width:100%;max-width:1000px;border-radius:12px;border:1px solid var(--dee-line)}.duo-review{padding-bottom:90px}.duo-review>p{max-width:840px}.duo-section .micro{max-width:950px;line-height:1.7}@media(max-width:600px){.duo-main{padding-top:40px}.duo-pair{grid-template-columns:1fr;gap:36px}.duo-closed{width:65%;justify-self:center}.duo-section{padding-top:44px;margin-top:40px}.duo-section h2{font-size:2.7rem}.press-header>.eyebrow{display:none}}
</style></body></html>
