---
import SiteHead from '@/components/SiteHead.astro'
import PressHeader from '@/components/PressHeader.astro'
import PressFooter from '@/components/PressFooter.astro'
import DuoDevice from '@/components/DuoDevice.astro'
import press from '@/content/press.json'
import '@/styles/dee.css'
import '@/styles/press.css'
---
<!doctype html>
<html lang="en-GB">
<head>
  <SiteHead exactTitle="Dee on iPhone Duo — beside the mat" description="Your Muay Thai corner on iPhone Duo. Explore your plan on the open display, then follow your rounds beside the mat." image={{src:'/press/duo/social-preview-v2.png',alt:'Dee on iPhone Duo: Your corner. Beside the mat. Training overview and workout shown in Apple’s official device frames.',width:1200,height:630,type:'image/png'}} />
  <link rel="preload" href="/fonts/barlow-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/barlow-condensed-black.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body class="press-page">
<a class="skip-link" href="#main">Skip to content</a>
<PressHeader />
<main id="main">
  <section class="press-hero duo-hero wrap" aria-labelledby="duo-title">
    <div>
      <p class="eyebrow">iPhone Duo / Workout preview</p>
      <h1 id="duo-title">Your corner.<br /><em>Beside<br />the mat.</em></h1>
      <p class="intro">Prop up Duo. See your round, follow your next drill, and keep your hands free to train.</p>
      <div class="action-row"><a class="press-button" href="#concept">Watch the Duo film <span aria-hidden="true">↓</span></a><a class="text-link" href="#open">See Duo open ↓</a><a class="text-link" href="/press/">Full Dee press kit ↗</a></div>
      <p class="micro">Dee 1.0.18 for iPhone Duo · Available on the App Store<br />Native app captures and a five-pose film below.</p>
    </div>
    <figure>
      <div class="hero-art duo-art">
        <span class="art-label">BUILT FOR THE ROUND</span>
        <img class="duo-tent-hero" src="/press/duo/tent-hero-concept.png" width="1920" height="1080" fetchpriority="high" alt="Concept render of iPhone Duo propped in a tent pose, showing Dee’s large 02:45 workout timer, shadowboxing drill, next rest, and controls" />
        <span class="art-foot">iPhone Duo / Tent pose concept</span>
      </div>
      <figcaption class="duo-caption">Tent pose and distance-view workout concept rendered in Matte. See the open-display simulator captures below.</figcaption>
    </figure>
  </section>
  <section class="wrap duo-benefits" aria-label="Workout benefits">
    <div class="story-grid">
      <article><span class="story-number">01</span><h2>See your round.</h2><p>A large countdown, your current drill and one coaching cue make the landscape distance view easy to follow beside the mat.</p></article>
      <article><span class="story-number">02</span><h2>Keep your flow.</h2><p>Pause or resume directly. Open Controls for detailed instructions, audio settings and workout actions while your session continues.</p></article>
      <article><span class="story-number">03</span><h2>Stay with it.</h2><p>The display stays awake while you train, so the next glance is all you need.</p></article>
    </div>
  </section>
  <section class="wrap section duo-open" id="open" aria-labelledby="open-title">
    <div class="section-heading">
      <p class="eyebrow">Duo / Fully open</p>
      <h2 id="open-title">Open up.<br /><em>Make it your plan.</em></h2>
      <p class="intro">See your week’s sessions together, then shape your training around the time you have. Here’s Dee on Duo’s larger inner display.</p>
    </div>
    <div class="duo-open-grid">
      <figure>
        <a class="duo-capture-link" href="/press/duo/home-opened.png" aria-label="View the full-resolution training overview on open Duo">
          <DuoDevice display="inner"><img src="/press/duo/home-opened.png" width="2853" height="2007" loading="lazy" alt="Dee on the open Duo: this week’s training sessions in a two-column overview, with the next session ready to start" /></DuoDevice>
        </a>
        <figcaption><span class="eyebrow">01 / Your training week</span><h3>Find your next round.</h3><p>Browse this week’s sessions and start the next workout from your home screen.</p></figcaption>
      </figure>
      <figure>
        <a class="duo-capture-link" href="/press/duo/plan-opened.png" aria-label="View the full-resolution plan editor on open Duo">
          <DuoDevice display="inner"><img src="/press/duo/plan-opened.png" width="2853" height="2007" loading="lazy" alt="Dee’s Tweak your plan sheet on the open Duo, with four weekly sessions selected and the training plan visible behind it" /></DuoDevice>
        </a>
        <figcaption><span class="eyebrow">02 / Your own rhythm</span><h3>Make room for training.</h3><p>Adjust your weekly schedule in a focused sheet, with your plan still in view.</p></figcaption>
      </figure>
    </div>
    <p class="micro duo-open-note">Actual app captures from the iOS 27.1 simulator, with sample training data. Shown in Apple’s official fully open Duo frame. Select a screen to view the original capture.</p>
  </section>
  <section class="wrap section duo-concept" id="concept" aria-labelledby="concept-title">
    <div class="section-heading">
      <p class="eyebrow">Duo / Five poses</p>
      <h2 id="concept-title">One workout.<br /><em>Five poses.</em></h2>
      <p class="intro">Closed, open landscape, open portrait, tabletop and tent. See Dee’s workout layouts in motion, including the new distance-view screen: put it down and keep moving.</p>
      <p class="micro">19.5 seconds · 1920 × 1080 · music</p>
    </div>
    <figure>
      <video class="duo-concept-video" width="1920" height="1080" controls playsinline preload="none" poster="/press/duo/duo-five-poses-2026-10-02.jpg" aria-label="Dee on iPhone Duo: closed, open landscape, open portrait, tabletop and tent workout preview" aria-describedby="duo-film-caption">
        <source src="/press/duo/duo-five-poses-2026-10-02.mp4" type="video/mp4" />
        <p><a href="/press/duo/duo-five-poses-2026-10-02.mp4">Download the five-pose Duo film</a></p>
      </video>
      <figcaption class="duo-caption" id="duo-film-caption">Native Dee simulator captures with sample workout data and device poses animated in Matte. The distance-view workout is included in Dee 1.0.18, now available on the App Store.</figcaption>
    </figure>
    <a class="text-link" href="/press/duo/duo-five-poses-2026-10-02.mp4" download>Download the Duo film MP4 ↓</a>
  </section>
  <section class="wrap section duo-review" aria-labelledby="review-title">
    <div>
      <p class="eyebrow">Take it for a round</p>
      <h2 id="review-title">In your corner.</h2>
      <p class="intro">Dee is an independent Muay Thai training app by Noam Efergan. Get the full story, explore the app, or get in touch for a walkthrough.</p>
      <div class="action-row"><a class="press-button" href={`mailto:${press.contact}?subject=Dee%20Duo%20review`}>Request review access ↗</a><a class="text-link" href="/press/">Explore the press kit ↗</a></div>
    </div>
    <aside class="duo-notes" aria-label="Preview details">
      <p class="eyebrow">About this preview</p>
      <p>Dee 1.0.18 is available on the App Store, including the native distance-view workout shown in the film. It arrives ahead of iPhone Duo reaching customers on 23 October.</p>
      <p>The regular workout adapts to display size and orientation; Reaction Rounds also responds to Duo’s hinge posture. Simulator captures do not verify physical tent placement, outer-display handoff, audio or haptics on a real Duo.</p>
      <p class="micro">Frame: <a href="https://developer.apple.com/design/resources/#product-bezels">Apple Design Resources</a><br />Captures: Dee / Noam Efergan · September–October 2026</p>
    </aside>
  </section>
</main>
<PressFooter />
</body>
</html>
<style>
  .duo-hero { grid-template-columns: .92fr 1.08fr; gap: 54px; }
  .duo-hero h1 { font-size: clamp(76px, 7.7vw, 106px); }
  .duo-hero .intro { max-width: 33ch; }
  .duo-art { height: 510px; padding: 30px 14px; background: #e7f1f7; isolation: isolate; }
  .duo-tent-hero { position: absolute; left: 50%; top: 50%; width: 145%; max-width: none !important; height: auto; transform: translate(-50%, -50%); mix-blend-mode: multiply; z-index: 1; }
  .duo-art .art-label, .duo-art .art-foot { z-index: 2; }
  .duo-caption { margin-top: 17px; color: var(--dee-muted); font-size: 13px; line-height: 1.55; max-width: 580px; }
  .duo-benefits { padding-bottom: 80px; }
  .duo-benefits h2 { font-size: 35px; font-weight: 700; margin: 0 0 18px; }
  .duo-benefits .story-number { margin-bottom: 22px; }
  .duo-open { border-bottom: 1px solid var(--dee-line); }
  .duo-open-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 44px; }
  .duo-capture-link { display: block; cursor: zoom-in; }
  .duo-open-grid figcaption { padding-top: 30px; }
  .duo-open-grid .eyebrow { display: block; color: var(--dee-teal-dark); margin-bottom: 12px; }
  .duo-open-grid h3 { margin-bottom: 12px; }
  .duo-open-grid p { font-size: 17px; color: var(--dee-muted); max-width: 45ch; }
  .duo-open-note { margin-top: 24px !important; max-width: 80ch; }
  .duo-concept { border-bottom: 1px solid var(--dee-line); }
  .duo-concept .section-heading { max-width: 760px; }
  .duo-concept-video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #101820; border-radius: 18px; }
  .duo-concept .duo-caption { max-width: 90ch; }
  .duo-concept > .text-link { display: inline-block; margin-top: 22px; }
  .duo-review { display: grid; grid-template-columns: 1.1fr .9fr; gap: 80px; align-items: start; }
  .duo-review h2 { font-size: clamp(48px, 5.5vw, 72px); margin: 18px 0 24px; }
  .duo-notes { border-top: 2px solid var(--dee-ink); padding-top: 23px; }
  .duo-notes > p:not(.eyebrow) { font-size: 15px; color: var(--dee-muted); }
  @media (max-width: 1000px) {
    .duo-hero { gap: 30px; }
    .duo-art { height: 450px; padding-inline: 8px; }
    .duo-review { gap: 40px; }
  }
  @media (max-width: 700px) {
    .duo-hero { grid-template-columns: 1fr; gap: 25px; }
    .duo-hero h1 { font-size: clamp(58px, 16vw, 82px); }
    .duo-art { height: auto; min-height: 300px; padding: 55px 10px; }
    .duo-benefits { padding-bottom: 55px; }
    .duo-review, .duo-open-grid { grid-template-columns: 1fr; gap: 35px; }
  }
</style>
