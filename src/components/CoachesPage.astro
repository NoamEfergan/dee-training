---
import { Image } from 'astro:assets'
import SiteHead from '@/components/SiteHead.astro'
import DownloadLinks from '@/components/DownloadLinks.astro'
import { campaignStoreURLs } from '@/lib/campaign-links.mjs'
import { deeContent, deeLocales, deePath, type DeeLocale } from '@/content/content'
import { coachesCampaign, coachesCopy, coachesEmail, coachesPath, instagramDMURL } from '@/content/coaches'
import appIcon from '@/assets/dee/app-icon.png'
import roundTimer from '@/assets/dee/paid/build33-round-timer.png'
import iphoneBezel from '@/assets/dee/devices/iphone-17-pro-max-deep-blue.png'
import '@/styles/dee.css'

interface Props {
  locale: DeeLocale
}

const { locale } = Astro.props
const copy = coachesCopy[locale]
const site = deeContent[locale]
const { appStoreURL, googlePlayURL } = campaignStoreURLs(coachesCampaign)
const mailto = `mailto:${coachesEmail}?subject=${encodeURIComponent(copy.mailSubject)}`
const canonical = new URL(coachesPath(site.routeSlug), Astro.site)
const localeAlternates = [
  ...deeLocales.map((code) => ({
    lang: deeContent[code].htmlLang,
    href: new URL(coachesPath(deeContent[code].routeSlug), Astro.site),
  })),
  { lang: 'x-default', href: new URL('/coaches/', Astro.site) },
]
---

<!doctype html>
<html lang={site.htmlLang} dir={site.direction}>
  <head>
    <SiteHead
      exactTitle={copy.metaTitle}
      description={copy.description}
      canonical={canonical}
      locale={site.htmlLang}
      localeAlternates={localeAlternates}
    />
    <link rel="preload" href="/fonts/barlow-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-black.woff2" as="font" type="font/woff2" crossorigin />
    {site.direction === 'rtl' && (
      <>
        <link rel="preload" href="/fonts/heebo-hebrew-400-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/heebo-hebrew-900-normal.woff2" as="font" type="font/woff2" crossorigin />
      </>
    )}
  </head>
  <body class="coaches-page">
    <a class="skip-link" href="#main">{copy.skip}</a>
    <header class="coaches-topbar" data-download-header>
      <a class="coaches-brand" href={deePath(locale)} aria-label={copy.home}>
        <Image src={appIcon} alt="" width={40} height={40} loading="eager" /><span dir="ltr">DEE</span>
      </a>
      <div class="coaches-topbar__end">
        <details class="language-picker">
          <summary aria-label={copy.language}>{site.nativeName}</summary>
          <div class="language-menu">
            {deeLocales.map((code) => (
              <a href={coachesPath(deeContent[code].routeSlug)} lang={deeContent[code].htmlLang} hreflang={deeContent[code].htmlLang} dir={deeContent[code].direction} aria-current={code === locale ? 'page' : undefined}>
                {deeContent[code].nativeName}
              </a>
            ))}
          </div>
        </details>
        <DownloadLinks appStoreURL={appStoreURL} googlePlayURL={googlePlayURL} />
      </div>
    </header>

    <main id="main">
      <section class="coaches-hero" aria-labelledby="coaches-title">
        <div class="coaches-hero__copy">
          <p class="coaches-eyebrow">{copy.eyebrow}</p>
          <h1 id="coaches-title">{copy.title}</h1>
          <p class="coaches-lead">{copy.lead}</p>
          <div class="coaches-actions">
            <a class="coaches-btn coaches-btn--primary" href={instagramDMURL} rel="noopener noreferrer">
              {copy.primary}<span class="visually-hidden"> {copy.primaryHint}</span>
            </a>
            <a class="coaches-btn coaches-btn--secondary" href={mailto}>{copy.secondary}</a>
          </div>
        </div>
        <figure class="coaches-phone" aria-label={copy.productPanel}>
          <Image class="coaches-phone__screen" src={roundTimer} alt={copy.iphoneAlt} width={420} loading="eager" />
          <Image class="coaches-phone__bezel" src={iphoneBezel} alt="" width={420} loading="eager" />
        </figure>
      </section>

      <div class="coaches-sections">
        <section class="coaches-card" aria-labelledby="coaches-what">
          <h2 id="coaches-what">{copy.whatTitle}</h2>
          <p>{copy.whatBody}</p>
        </section>
        <section class="coaches-card" aria-labelledby="coaches-how">
          <h2 id="coaches-how">{copy.howTitle}</h2>
          <ol>
            {copy.steps.map((step) => <li>{step}</li>)}
          </ol>
        </section>
        <section class="coaches-card" aria-labelledby="coaches-ask">
          <h2 id="coaches-ask">{copy.askTitle}</h2>
          <p>{copy.askBody}</p>
        </section>
      </div>

      <p class="coaches-indie">{copy.indie}</p>
      <p class="coaches-fine">{copy.fine}</p>
    </main>

    <footer class="coaches-footer">
      <span>© 2026 Dee</span>
      <nav aria-label={copy.legal}>
        <a href="/PrivacyPolicy/">{copy.privacy}</a>
        <a href="/TermsAndConditions/">{copy.terms}</a>
      </nav>
      <p>{copy.disclaimer}</p>
    </footer>

    <style is:global>
      html:has(.coaches-page) { background: #090d12; color-scheme: dark; }
      .coaches-page {
        min-height: 100vh;
        background:
          radial-gradient(circle at 78% 8%, rgba(10, 158, 184, 0.16), transparent 32rem),
          linear-gradient(rgba(241, 244, 248, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(241, 244, 248, 0.035) 1px, transparent 1px),
          #090d12;
        background-size: auto, 48px 48px, 48px 48px, auto;
        color: var(--dee-paper);
      }
      .coaches-page .visually-hidden {
        position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
        overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
      }
      .coaches-topbar {
        position: sticky; z-index: 50; top: 0;
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 16px;
        border-bottom: 1px solid rgba(241, 244, 248, 0.17);
        background: rgba(9, 13, 18, 0.96);
        padding: 8px 16px;
        backdrop-filter: blur(18px);
      }
      .coaches-brand {
        display: inline-flex; align-items: center; gap: 10px;
        color: var(--dee-paper); text-decoration: none;
        font: 900 1.5rem/1 'Barlow Condensed', sans-serif; letter-spacing: 0.1em;
      }
      .coaches-brand img { border-radius: 11px; }
      .coaches-topbar__end { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; }
      .coaches-page .language-picker summary { color: var(--dee-paper); }
      .coaches-page .language-picker summary:focus-visible,
      .coaches-brand:focus-visible,
      .coaches-footer a:focus-visible,
      .coaches-btn:focus-visible,
      .coaches-page .language-menu a:focus-visible { outline: 3px solid #82e1ee; outline-offset: 3px; }
      .coaches-page .language-menu { border-color: rgba(241, 244, 248, 0.2); }
      html[dir='rtl'] .coaches-page { font-family: 'Heebo', 'Barlow', sans-serif; }

      .coaches-hero, .coaches-sections, .coaches-indie, .coaches-fine, .coaches-footer {
        width: min(1080px, calc(100% - 32px)); margin-inline: auto;
      }
      .coaches-hero {
        display: grid; gap: 32px; align-items: center; padding: 36px 0 28px;
      }
      .coaches-eyebrow {
        margin: 0 0 12px; color: #82e1ee; font-size: 0.8rem; font-weight: 600;
        letter-spacing: 0.16em; text-transform: uppercase;
      }
      html[dir='rtl'] .coaches-eyebrow { letter-spacing: 0; }
      .coaches-hero h1 {
        margin: 0; max-width: 14ch;
        font: 900 clamp(2.6rem, 11vw, 4.8rem)/0.95 'Barlow Condensed', sans-serif;
        letter-spacing: -0.02em; text-transform: uppercase; text-wrap: balance;
      }
      html[dir='rtl'] .coaches-hero h1 { font-family: 'Heebo', sans-serif; font-weight: 900; line-height: 1.1; letter-spacing: 0; text-transform: none; max-width: 16ch; }
      html:lang(de) .coaches-hero h1, html:lang(nl) .coaches-hero h1 { hyphens: auto; overflow-wrap: anywhere; }
      .coaches-lead {
        max-width: 40rem; margin: 18px 0 0; color: rgba(241, 244, 248, 0.82);
        font-size: 1.08rem; line-height: 1.55;
      }
      .coaches-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
      .coaches-btn {
        display: inline-flex; min-height: 48px; align-items: center; justify-content: center;
        border-radius: 999px; padding: 10px 24px; font-weight: 700; line-height: 1.25;
        text-align: center; text-decoration: none;
      }
      .coaches-btn--primary { background: var(--dee-teal); color: var(--dee-ink); }
      .coaches-btn--primary:hover { background: #2bb7cf; }
      .coaches-btn--secondary { border: 1.5px solid rgba(241, 244, 248, 0.55); color: var(--dee-paper); }
      .coaches-btn--secondary:hover { background: rgba(241, 244, 248, 0.1); }

      .coaches-phone { position: relative; width: min(60%, 250px); aspect-ratio: 1470 / 3000; margin: 0 auto; }
      .coaches-phone__screen {
        position: absolute; top: 2.2%; left: 5.1020408163%; width: 89.7959183673%; height: 95.6%;
        border-radius: 14% / 6.5%;
      }
      .coaches-phone__bezel { position: relative; display: block; width: 100%; height: auto; pointer-events: none; }

      .coaches-sections { display: grid; gap: 14px; padding-block: 8px; }
      .coaches-card {
        border: 1px solid rgba(241, 244, 248, 0.17); border-top: 3px solid var(--dee-teal);
        background: rgba(241, 244, 248, 0.04); padding: 20px 22px 22px;
      }
      .coaches-card h2 {
        margin: 0 0 10px; font: 800 1.4rem/1.1 'Barlow Condensed', sans-serif;
        letter-spacing: 0.08em; text-transform: uppercase;
      }
      html[dir='rtl'] .coaches-card h2 { font-family: 'Heebo', sans-serif; letter-spacing: 0; text-transform: none; font-size: 1.25rem; }
      .coaches-card p, .coaches-card ol { margin: 0; color: rgba(241, 244, 248, 0.84); line-height: 1.55; }
      .coaches-card ol { padding-inline-start: 1.3em; }
      .coaches-card li + li { margin-top: 8px; }
      .coaches-indie { margin-block: 26px 0; font-weight: 600; line-height: 1.5; }
      .coaches-fine { margin-block: 10px 0; color: rgba(241, 244, 248, 0.72); font-size: 0.85rem; line-height: 1.5; }
      .coaches-footer {
        display: flex; flex-wrap: wrap; gap: 10px 24px; margin-block: 40px 0; padding-bottom: 28px;
        color: rgba(241, 244, 248, 0.6); font-size: 0.75rem;
      }
      .coaches-footer nav { display: flex; gap: 18px; }
      .coaches-footer a { color: rgba(241, 244, 248, 0.8); }
      .coaches-footer p { flex-basis: 100%; margin: 0; }

      @media (min-width: 821px) {
        .coaches-topbar { padding-inline: max(24px, calc((100vw - 1080px) / 2)); }
        .coaches-hero { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); padding-block: 56px 36px; }
        .coaches-phone { width: min(100%, 270px); }
        .coaches-sections { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }
      @media (max-width: 560px) {
        .coaches-topbar { justify-content: center; }
        .coaches-brand { width: 100%; justify-content: center; }
        .coaches-page .topbar-downloads { justify-content: center; }
        .coaches-btn { width: 100%; }
      }
    </style>
  </body>
</html>
